# Nexstep Gallery - Environment Variables Template
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@host:5432/nexstep?schema=public

# Authentication Secrets
JWT_SECRET="your-secure-random-jwt-secret-string"
ADMIN_BOOTSTRAP_SECRET="secure-one-time-admin-setup-key"

# App Public Domain
NEXT_PUBLIC_APP_URL="https://nexstepgallery.com"

# Payment Gateways (Bangladesh & Global)
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcommerz_store_password"
SSLCOMMERZ_IS_SANDBOX="true" # Set to false in production

BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_IS_SANDBOX="true"

NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"
NAGAD_IS_SANDBOX="true"

# Courier Integration Providers
PATHAO_CLIENT_ID="your_pathao_client_id"
PATHAO_CLIENT_SECRET="your_pathao_client_secret"
PATHAO_USERNAME="your_pathao_username"
PATHAO_PASSWORD="your_pathao_password"

STEADFAST_API_KEY="your_steadfast_api_key"
STEADFAST_SECRET_KEY="your_steadfast_secret_key"

REDX_API_TOKEN="your_redx_api_token"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Nexstep Gallery <orders@nexstepgallery.com>"

# Cloudinary / S3 Media CDN
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
